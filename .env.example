# Copy to .env and edit for your environment:
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
#
# Nothing loads .env automatically. Export it before running the server:
#
#   set -a; . ./.env; set +a
#   go run ./cmd/server

PORT=8080

# Matches deploy/docker-compose.yml. Replace user, password and host for any
# environment that is not the local Compose stack.
DATABASE_URL=postgres://shortener:shortener@localhost:5435/shortener?sslmode=disable

# Used only by the integration test; when unset the test is skipped.
TEST_DATABASE_URL=postgres://shortener:shortener@localhost:5435/shortener?sslmode=disable
